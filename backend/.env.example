# ========================================================
# StudyFlow Backend - Variáveis de Ambiente
# ========================================================

# Ambiente e Porta
NODE_ENV=production
PORT=3000

# Conexão com o Banco de Dados PostgreSQL (EasyPanel / Docker)
# Deixe em branco para usar o armazenamento local em JSON
DATABASE_URL=postgres://studyflow:SUA_SENHA_AQUI@studyflow-db:5432/studyflow

# Conexão com Cache Redis (Opcional - EasyPanel)
REDIS_URL=redis://studyflow-redis:6379

# Token Secreto para Operações Administrativas (Admin Panel)
ADMIN_API_SECRET=studyflow_admin_secret_token_change_me

# Provedores de Inteligência Artificial (Preencha pelo menos um)
# Opção 1: Google Gemini (Recomendado - Gratuito em https://aistudio.google.com/)
GEMINI_API_KEY=

# Opção 2: OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# CORS (Permitir acesso do app e painel admin)
CORS_ORIGIN=*
